# ==============================================================================
# Goodbaye Universal Standard - Environment Variables Template
# Repository: https://github.com/alireza786786/Free-V2ray-Configs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GitHub Token Configuration (Rate Limit & Actions)
# ------------------------------------------------------------------------------
# Classic Personal Access Token with 'repo' and 'workflow' permissions
GITHUB_TOKEN=your_classic_pat_token_here
GH_TOKEN=your_classic_pat_token_here

# (Optional) GitHub App credentials for dual token rotation
GH_APP_ID=
GH_APP_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 2. Telegram Publisher Bot Configuration
# ------------------------------------------------------------------------------
# Bot Token created from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Official destination channels (Username or Chat ID)
TARGET_CHAT_ID=@Goodbaye_filtering
VIP_CHAT_ID=@CONFIG_V2RAY_VIP
